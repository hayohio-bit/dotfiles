# WSL2 리소스 제한 설정
# 저사양 PC에서 Docker/WSL 실행 시 호스트가 정지 수준으로 느려지는 문제를 완화한다.
# 변경 후 적용: wsl --shutdown
#
# 값을 잡는 기준
#   보유한 PC 중 가장 사양이 낮은 것에 맞춘다.
#   .wslconfig 는 .gitconfig 의 [include] 같은 분기 수단이 없어 PC 별로 나눌 수 없으므로,
#   여유가 있는 PC 에서는 복사한 뒤 $HOME\.wslconfig 를 직접 올려 쓴다.
#   (bootstrap 은 덮어쓰기 전 $HOME\.wslconfig.bak 으로 백업한다.)
#
#   호스트 RAM   memory   processors
#   8GB          3GB      2
#   16GB         6GB      물리 코어의 절반
#   32GB 이상    8GB      물리 코어의 절반
#
# 한계
#   이 파일은 WSL VM(vmmem)에만 적용된다.
#   Docker Desktop 의 Windows 측 프로세스(com.docker.backend, Electron GUI, 자동 업데이트)는
#   여기서 제한되지 않는다. 그쪽 부하까지 없애려면 Docker Desktop 을 제거하고
#   WSL 배포판 안에 Docker Engine 을 직접 설치해야 한다. (README "WSL 및 Docker 설정" 참고)

[wsl2]
# 호스트에 최소 4GB 는 남겨 스와핑을 막는다. 상한을 너무 높이면 Windows 쪽이 밀리면서
# 오히려 CPU 사용률이 튀므로, 부족할 때 올리는 방향으로 조정한다.
memory=4GB

# CPU 급등의 직접적인 제동 장치. 물리 코어 수보다 반드시 낮게 잡는다.
processors=2

# memory 상한을 낮췄으므로 swap 을 두어 컨테이너가 OOM 으로 죽는 것을 막는다.
swap=2GB

localhostForwarding=true

[experimental]
# 유휴 상태에서 점유한 메모리를 호스트에 서서히 돌려준다.
autoMemoryReclaim=gradual
# 가상 디스크가 삭제한 만큼 실제로 줄어들게 한다.
sparseVhd=true
