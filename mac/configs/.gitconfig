# PC 고유 설정(사내 git 서버 credential, core.hooksPath, core.excludesFile 등)은
# 이 파일에 넣지 말고 ~/.gitconfig.local 에 작성한다. 아래 include 가 뒤에서 읽으므로
# 같은 키를 다시 정의하면 로컬 값이 우선한다. 파일이 없으면 git 이 조용히 무시한다.
#
# windows/configs/.gitconfig 와 거의 같으나 아래 두 항목이 다르다.
#   core.autocrlf  : Windows 는 true, macOS 는 input (커밋할 때만 LF 로 정규화)
#   core.longpaths : Windows 전용 설정이라 여기에는 없다

[user]
	name = serena
	email = 239265396+hayohio-bit@users.noreply.github.com

[init]
	defaultBranch = main

[core]
	autocrlf = input
	quotepath = false
	# macOS 는 파일명을 NFD(자소 분리)로 저장하므로, git 이 NFC 로 되돌려
	# 다른 OS 와 같은 파일명으로 다루게 한다. 한글 파일명에서 특히 중요하다.
	precomposeunicode = true

[pull]
	rebase = false

[fetch]
	prune = true

[push]
	default = current
	autoSetupRemote = true

[diff]
	renames = copies

[alias]
	st = status -sb
	co = checkout
	br = branch
	lg = log --oneline --graph --decorate --all
	last = log -1 HEAD --stat

[credential "https://github.com"]
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper = !gh auth git-credential

# 마지막에 두어 PC 고유 설정이 위 값을 덮어쓸 수 있게 한다.
[include]
	path = ~/.gitconfig.local
