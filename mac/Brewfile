# ---------------------------------------------------------------------------
cask "tailscale-app"  # cask 토큰이 `tailscale` 에서 바뀌었다. `tailscale` 은 CLI 데몬이다.
cask "google-chrome"
cask "chrome-remote-desktop-host"
cask "comet"

# ---------------------------------------------------------------------------
# 문서 / 메모
# ---------------------------------------------------------------------------
cask "obsidian"
cask "notion"

# 포스트잇 메모(Windows 판의 Stickies)는 macOS 에 Stickies.app 이 기본 내장이라 없다.

