# Homebrew 설치 목록 (brew bundle 이 읽는다)
#
# 실행:  brew bundle install --file=Brewfile --no-upgrade
#        (bootstrap.sh 2단계가 이 명령을 대신 실행한다)
#
# 지시자
#   brew "..."  CLI 도구와 라이브러리 (formula)
#   cask "..."  GUI 앱 (/Applications 에 설치)
#   tap  "..."  Homebrew 기본 저장소에 없는 패키지의 출처 추가
#   mas  "..."  Mac App Store 앱 (mas-cli 필요, App Store 로그인 선행 필수)
#
# brew bundle 은 이미 설치된 항목을 건너뛴다. 다만 기본 동작이 "outdated 항목 업그레이드"
# 이므로, bootstrap.sh 는 --no-upgrade 를 붙여 누락분만 설치한다.
# 최신 버전으로 올리려면 bootstrap.sh --upgrade-existing 을 쓴다.
#
# Windows 판(../windows/apps/)은 권한에 따라 scoop-apps.txt 와 winget-apps.json 으로
# 목록이 나뉘지만, Homebrew 는 관리자 권한을 따지지 않으므로 이 파일 하나로 끝난다.

# ---------------------------------------------------------------------------
# 출처 (tap)
# ---------------------------------------------------------------------------
# Orca 는 Homebrew 기본 저장소에 없어 배포처의 tap 을 추가해야 한다.
# 공식 문서의 설치 명령은 `brew install --cask stablyai/orca/orca` 로, tap 이름을
# 함께 적으면 자동으로 tap 이 추가된다. Brewfile 에서는 tap 을 명시하고
# 아래에서 짧은 이름 `orca` 로 참조한다.
tap "stablyai/orca"

# ---------------------------------------------------------------------------
# 런타임
# ---------------------------------------------------------------------------
# 버전 관리자(nvm, pyenv)는 넣지 않는다. Windows 판과 같은 이유로, 언어당 한 버전만 둔다.
# 버전 전환이 실제로 필요해지면 그때 아래로 교체한다.
#   brew uninstall node@24 && brew install nvm
#   brew uninstall python@3.14 && brew install pyenv

# node@24 는 Active LTS 다. 새 LTS 가 나오면 이 줄의 번호를 올린다.
# 버전이 붙은 formula 는 keg-only 라 /opt/homebrew/bin 에 심볼릭 링크가 생기지 않는다.
# bootstrap.sh 2-1 단계가 ~/.zprofile 에 PATH 를 추가해 `node` 명령이 잡히게 한다.
brew "node@24"

# 버전 없는 `python` 은 현재 기본 파이썬(2026-08 기준 3.14)을 가리키는 별칭이다.
# Scoop 의 `python` 과 같이 최신 안정판을 따라가며, keg-only 가 아니라서
# `python3` 가 바로 PATH 에 잡힌다. 특정 버전에 묶어야 하면 `python@3.14` 로 바꾼다.
brew "python"

cask "temurin@21"     # Eclipse Temurin JDK 21. formula 가 아니라 cask 다.

# rustup 은 `rust` formula 와 충돌해 keg-only 다. `rustup` 명령 자체는 심볼릭 링크가
# 따로 생겨 잡히지만 `rustc` / `cargo` 는 잡히지 않으므로, bootstrap.sh 2-1 단계가
# PATH 를 추가한다. 기본 툴체인이 stable 로 미리 설정되어 있어
# `rustup default stable` 을 따로 실행할 필요는 없다.
brew "rustup"

# ---------------------------------------------------------------------------
# CLI 도구
# ---------------------------------------------------------------------------
# git 과 gh 는 리포지토리를 clone 하기 전에 이미 있어야 하므로 README 2단계에서 먼저
# 설치한다. 여기 남겨둔 것은 재실행 시 설치 상태를 추적하기 위한 것이다.
# (macOS 는 Xcode Command Line Tools 에 git 이 포함되어 있어 clone 자체는 가능하지만,
#  버전이 오래되어 Homebrew 판으로 갈아둔다.)
brew "git"
brew "gh"

brew "sevenzip"       # 터미널용 7z. GUI 압축은 Bandizip/Keka 담당
brew "ripgrep"
brew "fzf"
brew "mas"            # Mac App Store 앱 설치용. 아래 mas 항목이 이것을 필요로 한다.

# Windows 판의 `sudo` 는 Windows 에 sudo 가 없어 넣은 것이다. macOS 는 기본 내장이라 없다.

# ---------------------------------------------------------------------------
# 터미널 / 에디터 / IDE
# ---------------------------------------------------------------------------
# Windows 판의 Windows Terminal 자리다. macOS 기본 Terminal.app 도 쓸 만하지만
# Warp 를 이미 쓰고 있으므로 그대로 둔다.
cask "warp"
cask "cursor"
cask "zed"
cask "antigravity"
cask "antigravity-ide"
cask "orca"           # 위 stablyai/orca tap 이 제공한다.

# ---------------------------------------------------------------------------
# 개발 인프라
# ---------------------------------------------------------------------------
cask "docker-desktop" # cask 토큰이 `docker` 에서 바뀌었다. `docker` 는 CLI 전용이다.
cask "dbeaver-community"
cask "mysqlworkbench"

# DB 서버는 로컬에 설치하지 않고 Docker 컨테이너로 띄운다. (../README.md 확정 스택 참고)

# ---------------------------------------------------------------------------
# 폰트
# ---------------------------------------------------------------------------
cask "font-hack"

# ---------------------------------------------------------------------------
# 네트워크 / 브라우저
# ---------------------------------------------------------------------------
cask "tailscale-app"  # cask 토큰이 `tailscale` 에서 바뀌었다. `tailscale` 은 CLI 데몬이다.
cask "google-chrome"
cask "chrome-remote-desktop-host"
cask "comet"

# ---------------------------------------------------------------------------
# 문서 / 메모
# ---------------------------------------------------------------------------
cask "obsidian"
cask "notion"

# 포스트잇 메모(Windows 판의 Stickies)는 macOS 에 Stickies.app 이 기본 내장이라 없다.

# ---------------------------------------------------------------------------
# 유틸리티
# ---------------------------------------------------------------------------
# Windows 판의 Everything(전체 파일명 즉시 검색)에 정확히 대응하는 앱은 macOS 에 없다.
# 기본 Spotlight 로 대체하고, 부족하면 아래 주석을 풀어 런처를 쓴다.
# cask "raycast"
# cask "alfred"

# 압축 GUI. Bandizip 의 macOS 판은 Mac App Store 전용이라 아래 mas 항목이 담당한다.
# App Store 를 쓰지 않겠다면 이 줄을 풀고 mas "Bandizip" 을 지운다.
# cask "keka"

# ---------------------------------------------------------------------------
# Mac App Store 전용 (mas)
# ---------------------------------------------------------------------------
# 아래 항목은 App Store 앱에 **미리 로그인해 두어야** 설치된다. 계정으로 한 번도 받은 적
# 없는 앱은 CLI 설치가 실패할 수 있으므로, 실패하면 App Store 에서 직접 한 번 받는다.
mas "KakaoTalk", id: 869223134
mas "Bandizip", id: 1265704574
