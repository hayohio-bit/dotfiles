# Homebrew 설치 목록 (brew bundle 이 읽는다)
#
# 실행:  brew bundle install --file=Brewfile --no-upgrade
#        (bootstrap.sh 2단계가 이 명령을 대신 실행한다)
#
# 지시자
#   brew "..."  CLI 도구와 라이브러리 (formula)
#   cask "..."  GUI 앱 (/Applications 에 설치)
#   tap  "..."  Homebrew 기본 저장소에 없는 패키지의 출처 추가
#   mas  "..."  Mac App Store 앱 (mas-cli 필요, App Store 로그인 선행 필수)
#
# brew bundle 은 이미 설치된 항목을 건너뛴다. 다만 기본 동작이 "outdated 항목 업그레이드"
# 이므로, bootstrap.sh 는 --no-upgrade 를 붙여 누락분만 설치한다.
# 최신 버전으로 올리려면 bootstrap.sh --upgrade-existing 을 쓴다.
#
# Windows 판(../windows/apps/)은 권한에 따라 scoop-apps.txt 와 winget-apps.json 으로
# 목록이 나뉘지만, Homebrew 는 관리자 권한을 따지지 않으므로 이 파일 하나로 끝난다.

# ---------------------------------------------------------------------------
# 출처 (tap)
# ---------------------------------------------------------------------------
# Orca 는 Homebrew 기본 저장소에 없어 배포처의 tap 을 추가해야 한다.
# 공식 문서의 설치 명령은 `brew install --cask stablyai/orca/orca` 로, tap 이름을
# 함께 적으면 자동으로 tap 이 추가된다. Brewfile 에서는 tap 을 명시하고
# 아래에서 짧은 이름 `orca` 로 참조한다.
tap "stablyai/orca"

# ---------------------------------------------------------------------------
# 런타임
# ---------------------------------------------------------------------------
# 언어 런타임은 Homebrew 로 직접 깔지 않는다. Homebrew 는 formula 하나당 한 버전만
# PATH 에 올리므로, Java 17 을 쓰는 저장소와 21 을 쓰는 저장소를 오가려면 매번
# 다시 링크해야 한다. 대신 mise 가 프로젝트별 전환을 담당한다.
#
# mise 는 shim 을 깐다. shim 은 실제 실행 파일 대신 PATH 에 놓이는 얇은 중계
# 실행 파일로, 호출되면 현재 디렉터리에서 위로 올라가며 mise.toml 을 찾아 거기 적힌
# 버전의 진짜 실행 파일로 넘긴다. 그래서 디렉터리만 옮기면 java -version 이 바뀐다.
#
# `mise activate` 가 셸의 프롬프트 훅을 걸어, shim 뿐 아니라 JAVA_HOME 같은 환경
# 변수도 디렉터리에 맞춰 갱신한다. bootstrap.sh 2-2 단계가 ~/.zshrc 에 이를 넣는다.
# (~/.zprofile 이 아닌 이유는 bootstrap.sh 2-2 단계의 주석에 적어 두었다.)
# Windows 도 `mise activate pwsh` 로 같은 일을 한다. ../windows/README.md 참고.
#
# 설치할 기본 버전은 configs/mise.toml 에 있고, bootstrap.sh 3-1 단계가
# ~/.config/mise/config.toml 로 배치한 뒤 `mise install` 을 실행한다.
#
# 프로젝트별 고정은 그 저장소 루트에서:
#   mise use java@temurin-17
#   mise use node@22
brew "mise"

# rustup 은 `rust` formula 와 충돌해 keg-only 다. `rustup` 명령 자체는 심볼릭 링크가
# 따로 생겨 잡히지만 `rustc` / `cargo` 는 잡히지 않으므로, bootstrap.sh 2-1 단계가
# PATH 를 추가한다. 기본 툴체인이 stable 로 미리 설정되어 있어
# `rustup default stable` 을 따로 실행할 필요는 없다.
#
# Rust 만 mise 가 아니라 rustup 이 맡는다. rustup 이 이미 rust-toolchain.toml 을 읽어
# 프로젝트별 전환을 하므로, mise 까지 끼면 같은 일을 두 곳에서 관리하게 된다.
brew "rustup"

# ---------------------------------------------------------------------------
# CLI 도구
# ---------------------------------------------------------------------------
# git 과 gh 는 리포지토리를 clone 하기 전에 이미 있어야 하므로 README 2단계에서 먼저
# 설치한다. 여기 남겨둔 것은 재실행 시 설치 상태를 추적하기 위한 것이다.
# (macOS 는 Xcode Command Line Tools 에 git 이 포함되어 있어 clone 자체는 가능하지만,
#  버전이 오래되어 Homebrew 판으로 갈아둔다.)
brew "git"
brew "gh"

brew "sevenzip"       # 터미널용 7z. GUI 압축은 Bandizip/Keka 담당
brew "ripgrep"
brew "fzf"
brew "mas"            # Mac App Store 앱 설치용. 아래 mas 항목이 이것을 필요로 한다.

# Windows 판의 `sudo` 는 Windows 에 sudo 가 없어 넣은 것이다. macOS 는 기본 내장이라 없다.

# ---------------------------------------------------------------------------
# 터미널 / 에디터 / IDE
# ---------------------------------------------------------------------------
# Windows 판의 Windows Terminal 자리다. macOS 기본 Terminal.app 도 쓸 만하지만
# Warp 를 이미 쓰고 있으므로 그대로 둔다.
cask "warp"
cask "cursor"
cask "zed"
cask "antigravity"
cask "antigravity-ide"
cask "orca"           # 위 stablyai/orca tap 이 제공한다.
cask "android-studio"

# ---------------------------------------------------------------------------
# 컨테이너
# ---------------------------------------------------------------------------
# Docker Desktop 은 쓰지 않는다. Windows 판이 WSL2 안에 Docker Engine 을 직접 까는
# 것과 같은 선택으로, macOS 에서는 Colima 가 그 자리를 맡는다.
#
# 배경: macOS 와 Windows 는 리눅스 커널이 없어서 컨테이너를 그냥 돌릴 수 없다.
# 어느 방식이든 리눅스 VM 안에서 도커 데몬을 띄우고 호스트의 CLI 가 그 데몬에
# 붙는 구조다. Docker Desktop 은 그 VM 과 GUI 를 묶어 파는 상용 제품이고,
# Colima 는 같은 일을 하는 오픈소스 CLI 다 (Lima VM + 도커 데몬).
#
#   colima start                  VM 을 띄우고 docker 컨텍스트를 자동 등록한다
#   colima start --cpu 4 --memory 8   자원을 지정해 띄운다
#   colima stop / colima delete   중지 / VM 삭제
#
# docker CLI 와 compose 는 Colima 에 딸려 오지 않으므로 따로 적는다.
brew "colima"
brew "docker"         # CLI 전용 formula. GUI 앱이 아니다.
brew "docker-compose" # `docker compose`(하이픈 없음) 하위 명령을 제공한다.

# ---------------------------------------------------------------------------
# 데이터베이스
# ---------------------------------------------------------------------------
brew "mysql"          # 로컬 MySQL 서버. 시작은 `brew services start mysql`.
cask "dbeaver-community"
cask "mysqlworkbench"

